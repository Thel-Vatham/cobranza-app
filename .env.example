# Copia este archivo como `.env` y ajusta los valores (no se sube al repositorio).
# En Render, configura estas variables desde el panel Environment.

# Conexión a la base de datos (en producción, PostgreSQL de Render).
# Ejemplo local SQLite no necesita esta línea.
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_bd

# Clave de sesión. Usa un valor largo y aleatorio en producción.
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# false = exige inicio de sesión (recomendado en producción).
AUTH_DISABLED=true
